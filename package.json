{
  "name": "@ryanbrandt/react-quick-ui",
  "version": "0.5.1",
  "author": "Ryan Brandt",
  "description": "React component/hooks library",
  "repository": "https://github.com/ryanbrandt/react-quick-ui",
  "main": "dist/index.js",
  "license": "MIT",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./stylesheets/*": "./dist/stylesheets/*",
    "./assets/*": "./dist/assets/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint --ext .ts --ext .tsx src/ __tests__/ --quiet",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook": "start-storybook -p 6006",
    "story:create": "bash ./scripts/create_story.sh",
    "svg:create": "bash ./scripts/create_svg.sh",
    "build-storybook": "build-storybook"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@mdx-js/react": "^1.6.22",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@ryanbrandt/react-testing-utils": "^0.5.0",
    "@storybook/addon-actions": "^6.5.6",
    "@storybook/addon-docs": "^6.5.6",
    "@storybook/addon-essentials": "^6.5.6",
    "@storybook/addon-interactions": "^6.5.6",
    "@storybook/addon-links": "^6.5.6",
    "@storybook/builder-webpack5": "^6.5.6",
    "@storybook/cli": "^6.5.6",
    "@storybook/manager-webpack5": "^6.5.6",
    "@storybook/react": "^6.5.6",
    "@storybook/testing-library": "^0.0.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-loader": "^8.2.4",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.7.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "~3.6.3",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-no-relative-import-paths": "^1.2.0",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.4.0",
    "eslint-plugin-react-prefer-function-component": "^1.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-transition-group": "^4.4.5",
    "rollup": "^4.63.5",
    "sass": "^1.50.0",
    "sass-loader": "^12.6.0",
    "style-loader": "^3.3.1",
    "ts-jest": "^29.4.14",
    "tsc-alias": "~1.8.17",
    "tslib": "^2.3.1",
    "typescript": "^6.0.3",
    "webpack": "^5.72.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-transition-group": ">=4.4.5"
  },
  "resolutions": {
    "@storybook/react-docgen-typescript-plugin": "1.0.6--canary.9.0c3f3b7.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@4.18.1"
}
