{
  "name": "@ryanbrandt/react-quick-ui",
  "version": "0.5.1",
  "author": "Ryan Brandt",
  "description": "React component/hooks library",
  "repository": "https://github.com/ryanbrandt/react-quick-ui",
  "main": "dist/index.js",
  "license": "MIT",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.esm.js",
      "default": "./dist/index.js"
    },
    "./stylesheets/*": "./dist/stylesheets/*",
    "./assets/*": "./dist/assets/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint . --max-warnings 4",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:react18": "REACT_VERSION=18 jest --coverage",
    "storybook": "storybook dev -p 6006",
    "story:create": "bash ./scripts/create_story.sh",
    "svg:create": "bash ./scripts/create_svg.sh",
    "build-storybook": "storybook build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@ryanbrandt/react-testing-utils": "^0.6.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "copyfiles": "^2.4.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-18": "npm:react@^18.3.1",
    "react-dom": "^19.3.0",
    "react-dom-18": "npm:react-dom@^18.3.1",
    "react-transition-group": "^4.4.5",
    "rollup": "^4.63.5",
    "sass": "^1.105.0",
    "storybook": "10.6.1",
    "ts-jest": "^29.4.14",
    "tsc-alias": "~1.8.17",
    "tslib": "^2.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "@types/react": ">=18.2.6",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-transition-group": "^4.4.5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@4.18.1"
}
